# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # auth handshake only; harmless under deny-all RLS
SUPABASE_SERVICE_ROLE_KEY=        # SERVER-ONLY — all data access. Never expose to client.

# App
APP_TZ=Asia/Jakarta

# Base URL for magic-link redirects (http://localhost:3000 in dev; your Vercel URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
