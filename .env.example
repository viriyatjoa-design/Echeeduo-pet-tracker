# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # auth handshake only; harmless under deny-all RLS
SUPABASE_SERVICE_ROLE_KEY=        # SERVER-ONLY — all data access. Never expose to client.

# App
APP_TZ=Asia/Jakarta

# Base URL for magic-link redirects (http://localhost:3000 in dev; your Vercel URL in prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (Milestone AI — Kimi/Moonshot, owner-approved). Server-only.
MOONSHOT_API_KEY=                 # platform.moonshot.ai → API keys
MOONSHOT_MODEL=kimi-k2.6          # the model you picked in the Moonshot console
# Optional: faster model for photo jobs (litter analysis + label scan) and
# the nightly morning report. K2.6 "thinks" before answering, which is slow
# for those. Pick a vision-capable non-thinking model ID from the Moonshot
# console (e.g. kimi-latest) — unset, everything uses MOONSHOT_MODEL.
MOONSHOT_VISION_MODEL=

# Protects the nightly morning-report cron endpoint. Any long random string
# (30+ chars). Vercel sends it automatically with each cron run; without it
# set, the cron is rejected (the manual Refresh button still works).
CRON_SECRET=
